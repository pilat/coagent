# Copy to ~/.coagent/secrets and fill in.
#
# This file is the only source for ${VAR} references in ~/.coagent/config.yaml.
# The process environment is deliberately not consulted for them: values here
# are read into memory and never exported, so tool subprocesses (bash, MCP
# servers, LSP) cannot read them.
#
# Referencing a variable that is not defined here fails config load and names
# the variable. In config.yaml providers.*.api_key, managers[].bot_token and
# tools.search.api_key accept a ${VAR} reference — everything else stays
# literal. MCP server env accepts the same references, resolved from this file
# when the server launches.

# Provider credentials — reference from providers.<name>.api_key
# Anthropic keys: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Telegram manager — reference from managers[].bot_token
TELEGRAM_TOKEN=

# Builtin websearch tool — reference from tools.search.api_key
# TAVILY_API_KEY=

# Credentials handed to MCP servers — reference from the env of an mcp_add call
# DATADOG_API_KEY=
# DATADOG_APP_KEY=

# Non-secret knobs may live here too, but the real environment wins for them,
# so exporting in your shell also works.
